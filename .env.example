# ==============================================================================
# PeerLink (cli-chat) - Environment Configuration Example
# ==============================================================================
# Copy this file to .env locally:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
#
# NOTE: .env contains machine-specific local settings and must NOT be committed to Git.
# ==============================================================================

# Signaling Server Configuration (Host running server.py)
# SERVER_HOST: IP address the signaling server binds to (0.0.0.0 binds to all network interfaces)
SERVER_HOST=0.0.0.0
# SERVER_PORT: TCP port for the signaling server (default: 5050 - avoids macOS AirPlay conflict on 5000)
SERVER_PORT=5050

# Client Connection Configuration (Device running client.py)
# SIGNALING_SERVER_IP: Public IP address, LAN IP, or domain name of the signaling server.
# For local network testing: e.g. 192.168.1.50
# For cloud deployment: e.g. 203.0.113.10 or chat-signal.example.com
SIGNALING_SERVER_IP=127.0.0.1

# WebRTC STUN Server Configuration
# STUN servers allow clients behind NAT routers to discover their public UDP endpoints.
# Multiple public STUN servers are freely available (Google, Cloudflare, etc.).
STUN_SERVER_URL=stun:stun.l.google.com:19302

# CLIENT_LISTEN_HOST: Interface for local network binding (default: 0.0.0.0)
CLIENT_LISTEN_HOST=0.0.0.0
# CLIENT_LISTEN_PORT: Port setting retained for CLI consistency (default: 6001)
CLIENT_LISTEN_PORT=6001

# Optional Preset Username (leave empty to be prompted interactively)
CLIENT_USERNAME=

# Application & Logging Configuration
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# DEBUG_MODE: Set to true for verbose WebRTC and signaling diagnostics
DEBUG_MODE=false
